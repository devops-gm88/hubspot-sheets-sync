# HubSpot Private App token. Least privilege: contacts read is the only scope the
# sync needs. Companies and schemas are read for the mapping audit.
HUBSPOT_TOKEN=pat-na1-xxxxxxxx
HUBSPOT_BASE=https://api.hubapi.com

# Any long random string for the local webhook receiver. HubSpot uses the app
# client secret for a real public app; this demo signs its own test payloads.
HUBSPOT_WEBHOOK_SECRET=change-me

# The Google Sheet must be shared with the service-account address as Editor.
SHEET_ID=
GOOGLE_SA_JSON=/absolute/path/to/sheets-sa.json
SYNC_TAB=hubspot_contacts
LOG_TAB=sync_log
EVENT_STORE=data/seen_events.json
